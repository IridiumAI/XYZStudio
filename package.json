{
  "name": "xyzstudio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @xyzstudio/server --filter @xyzstudio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @xyzstudio/server db:push"
  }
}
