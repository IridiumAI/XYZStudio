# XYZ Studio — environment configuration
# Copy to .env and fill in. Variables marked (optional) can stay blank;
# the corresponding provider adapter is simply disabled.

# ============================================================
# Infra (defaults match docker-compose; usually no edits needed)
# ============================================================
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=file:./data/xyzstudio.db
STORAGE_ROOT=./data
REDIS_URL=redis://localhost:6379

# ============================================================
# Auth (better-auth) — email/password, allowlist-gated signup
# ============================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Comma-separated emails allowed to register (seed list; extendable in DB later)
ALLOWLIST_EMAILS=yingjinglu2019us@gmail.com

# ============================================================
# Text generation — Anthropic Claude (required, Phase 1)
# https://platform.claude.com/ -> API keys
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# Image generation — OpenAI gpt-image-1 (Phase 1 sketches / Phase 2)
# https://platform.openai.com/ -> API keys
# ============================================================
OPENAI_API_KEY=

# ============================================================
# Video generation — Google Veo via Gemini API (Phase 2)
# https://aistudio.google.com/ -> Get API key (paid plan required for Veo)
# ============================================================
GEMINI_API_KEY=

# ============================================================
# Voice / TTS — ElevenLabs (Phase 2)
# https://elevenlabs.io/ -> Profile -> API keys
# ============================================================
ELEVENLABS_API_KEY=

# ============================================================
# (optional) Fallback / alternative provider adapters
# ============================================================
# fal.ai — FLUX image gen (character LoRA), Kling video
FAL_KEY=
# Runway — Gen-4 video
RUNWAY_API_KEY=

# ============================================================
# Cost guardrails
# ============================================================
# Upper bound of the per-video budget slider (budget is a soft target)
MAX_BUDGET_PER_VIDEO_USD=200
# Absolute runaway-cost hard stop per session: ceiling = budget x multiplier.
# Generous enough that normal overruns (soft budget) never hit it.
BUDGET_SAFETY_CEILING_MULTIPLIER=1.5
